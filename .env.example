# Zugangsdaten fuer die Auslieferung auf den IONOS-Webspace.
# Kopie dieser Datei als .env anlegen und ausfuellen. .env steht in
# .gitignore und darf niemals committet werden.
#
# Uebertragen wird per SFTP (Port 22). Gemessen am 27.08.2026: Der Server
# beherrscht kein FTPS, Port 21 waere Klartext. Die Zugangsdaten sind
# dieselben - im IONOS-Panel unter Hosting > SFTP-/FTP-Zugaenge.

SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=

# Zielverzeichnis auf dem Webspace. Der Zugang landet bereits IM
# Webverzeichnis - der Pfad /klassenchat aus dem IONOS-Dateimanager ist von
# hier aus nicht sichtbar. Deshalb schlicht der Schraegstrich.
SFTP_REMOTE_DIR=/

# Adresse, unter der das Verzeichnis oeffentlich erreichbar ist. Der Live-Check
# nach der Auslieferung misst gegen diese Adresse.
LIVE_BASE_URL=https://malzi.care
