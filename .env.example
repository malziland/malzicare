# Zugangsdaten fuer die Auslieferung auf den IONOS-Webspace.
# Kopie dieser Datei als .env anlegen und ausfuellen. .env steht in
# .gitignore und darf niemals committet werden.

# FTP-Server aus dem IONOS-Panel (Hosting > FTP-Zugaenge)
FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# Zielverzeichnis auf dem Webspace, absolut, ohne Schraegstrich am Ende
FTP_REMOTE_DIR=/klassenchat

# Verschluesselte Verbindung (FTPS explizit). Nur auf false setzen, wenn der
# Server sie nachweislich nicht beherrscht - dann steht das Passwort im Klartext
# auf der Leitung.
FTP_SECURE=true

# Adresse, unter der das Verzeichnis oeffentlich erreichbar ist. Der Live-Check
# nach der Auslieferung misst gegen diese Adresse.
LIVE_BASE_URL=https://klassenchat.malziland.at
